<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <External>null</External>
  <External>nil</External>
  <Item class="Workspace">
    <Properties>
      <string name="Name">Workspace</string>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder">
      <Properties>
        <string name="Name">MyLittlePets</string>
      </Properties>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">local C={Version=2,MaxPets=200,EquipSlots=3,StudioUseDataStore=false,DataStoreName="MyLittlePets_Profile_v2",InventoryRevision=2}
C.Rarities={"Common","Uncommon","Rare","Epic","Legendary","Mythic","Eternal","Heroic","Divine","EXCLUSIVE"}
C.Colors={Color3.fromRGB(188,207,220),Color3.fromRGB(73,207,111),Color3.fromRGB(48,164,249),Color3.fromRGB(165,79,239),Color3.fromRGB(255,169,44),Color3.fromRGB(238,63,75),Color3.fromRGB(101,44,210),Color3.fromRGB(250,232,192),Color3.fromRGB(255,211,39),Color3.fromRGB(90,240,211)}
C.Rates={"10000","50000","250000","1000000","5000000","25000000","125000000","600000000","1700000000","20000000000"}
C.Weights={45,30,15,7,2,.8,.15,.05,0,0}
C.Sectors={"Forest Entrance","Green Clearing","Deep Woods","Ancient Grove","Forest Gateway"}
C.Gates={"0","2000000","20000000","200000000","2000000000"}
C.EggCost="250000"
C.Biomes={"Forest","River","Desert","Ice","Volcanic"}
C.Origin={Forest=1,River=2,Desert=4,Ice=8,Volcanic=16}
C.Variants={Normal=1,Silver=3,Gold=7,Diamond=15,Rainbow=30}
C.Foods={{Id="Apple",Name="Apple",Cost="100000",XP=100},{Id="Fish",Name="Fish",Cost="500000",XP=500},{Id="GoldenFruit",Name="Golden Fruit",Cost="2500000",XP=2500},{Id="MysticTreat",Name="Mystic Treat",Cost="10000000",XP=10000}}
C.Weather={{Name="Rainy",Mutation="Soaked",Factor=1.5,Weight=40,Color=Color3.fromRGB(86,176,238)},{Name="Snowstorm",Mutation="Frozen",Factor=2.5,Weight=25,Color=Color3.fromRGB(190,237,255)},{Name="Thunderstorm",Mutation="Thunderstruck",Factor=4,Weight=18,Color=Color3.fromRGB(174,102,255)},{Name="Rage",Mutation="Enraged",Factor=7,Weight=10,Color=Color3.fromRGB(255,95,46)},{Name="Meteor Shower",Mutation="Celestial",Factor=12,Weight=5,Color=Color3.fromRGB(107,148,240)},{Name="Aurora",Mutation="Astral",Factor=25,Weight=2,Color=Color3.fromRGB(110,249,207)}}
C.Boosters={{Id="Basic",Name="Basic Lucky",Bonus=.05,ProductId=0},{Id="Super",Name="Super Lucky",Bonus=.15,ProductId=0},{Id="Ultra",Name="Ultra Lucky",Bonus=.25,ProductId=0}}
C.Targets={{Name="Small Coin Pile",Work="100000",Respawn=3,Count=6},{Name="Large Coin Pile",Work="500000",Respawn=5,Count=11},{Name="Giant Coin Hoard",Work="2000000",Respawn=8,Count=18},{Name="Wooden Chest",Work="10000000",Respawn=12,Count=0}}
C.Upgrades={} for i,price in ipairs({2,5,9,15,25,39,59,89,129,179,249,349}) do C.Upgrades[i]={Tier=i,Multiplier=2^i,TargetPrice=price,PassId=0} end
C.FutureCaps={Forest=4096,River=16384,Desert=65536,Ice=262144,Volcanic=1048576}
-- Product decisions without approved values stay disabled. Never invent checkout IDs or paid prices.
C.Divine={Enabled=false,DailyLimit=0}
C.Weekly={Enabled=false,Weekday=1,HourUTC=0,Chance=0}
C.PremiumProducts={}
C.Rush={Interval=1200,Registration=30,Countdown=5,Duration=60,Results=5,Speed=16,Range=6,Cooldown=.8,Grace=.5,Hold=.75}
C.Species={}
local groups={{"Forest Fox","Meadow Bunny","Acorn Mouse","Moss Chick","Twig Pup"},{"Leaf Cat","Clover Deer","Fern Frog","Sprout Owl","Hedgehog Scout"},{"Azure Jay","Crystal Badger","Riverbank Otter","Sapphire Squirrel"},{"Mystic Owl","Mooncap Cat","Orchid Moth","Rune Wolf"},{"Amber Griffin","Suncrest Lion","Ancient Stag"},{"Ember Imp","Crimson Drake","Thorn Phoenix"},{"Twilight Lynx","Void Raven"},{"Halo Hound","Pearl Pegasus"},{"Golden Dragon","Crowned Seraph"}}
for r,names in ipairs(groups) do for _,name in ipairs(names) do
 local i=#C.Species+1 local base=C.Colors[r]
 if r==1 then base=({Color3.fromRGB(224,126,63),Color3.fromRGB(233,223,216),Color3.fromRGB(173,142,116),Color3.fromRGB(235,207,92),Color3.fromRGB(162,114,77)})[i] end
 table.insert(C.Species,{Id=string.format("forest_%02d",i),Name=name,Rarity=r,Color=base,Rate=C.Rates[r],Biome="Forest"})
end end
function C.MutationFactor(pet)
 local factor=1 for _,id in ipairs(pet.Mutations or {}) do for _,w in ipairs(C.Weather) do if w.Mutation==id then factor+=w.Factor-1 end end end return factor
end
function C.Power(pet,tier,B)
 local s=C.Species[pet.Species] local n=s.Rate
 n=B.MulSmall(n,C.Origin[pet.Origin or s.Biome] or 1) n=B.MulSmall(n,C.Variants[pet.Variant or "Normal"] or 1)
 n=B.Div(B.MulSmall(n,math.floor(C.MutationFactor(pet)*100)),"100")
 n=B.Div(B.MulSmall(n,99+pet.Level),"100")
 for _=1,tier or 0 do n=B.MulSmall(n,2) end return n
end
function C.Validate()
 assert(#C.Species==30,"Forest roster") local counts={} local sum=0 local prices=0 local ids={}
 for _,s in ipairs(C.Species) do counts[s.Rarity]=(counts[s.Rarity] or 0)+1 assert(not ids[s.Id],"Species IDs") ids[s.Id]=true end
 for i,n in ipairs({5,5,4,4,3,3,2,2,2}) do assert(counts[i]==n,"Rarity distribution") end
 for _,v in ipairs(C.Weights) do assert(v&gt;=0) sum+=v end assert(math.abs(sum-100)&lt;.000001 and C.Weights[9]==0 and C.Weights[10]==0)
 for i,u in ipairs(C.Upgrades) do assert(u.Multiplier==2^i) prices+=u.TargetPrice end assert(prices==1149)
end
C.Validate()
return C
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">BigNum</string>
          <ProtectedString name="Source">-- Non-negative arbitrary precision integer arithmetic; wallet and rate wire format is decimal text.
local B={}
function B.N(v)
 local s=type(v)=="number" and string.format("%.0f",v) or tostring(v)
 assert(s:match("^%d+$") and #s&lt;=400,"Invalid unsigned decimal")
 return s:gsub("^0+","")=="" and "0" or (s:gsub("^0+",""))
end
function B.Cmp(a,b) a=B.N(a) b=B.N(b) if #a~=#b then return #a&gt;#b and 1 or -1 end if a==b then return 0 end return a&gt;b and 1 or -1 end
function B.Add(a,b)
 a=B.N(a) b=B.N(b) local out={} local carry=0 local i=#a local j=#b
 while i&gt;0 or j&gt;0 or carry&gt;0 do local n=(i&gt;0 and tonumber(a:sub(i,i)) or 0)+(j&gt;0 and tonumber(b:sub(j,j)) or 0)+carry table.insert(out,1,tostring(n%10)) carry=math.floor(n/10) i-=1 j-=1 end
 return table.concat(out)
end
function B.Sub(a,b)
 a=B.N(a) b=B.N(b) assert(B.Cmp(a,b)&gt;=0,"Negative balance") local out={} local borrow=0 local j=#b
 for i=#a,1,-1 do local n=tonumber(a:sub(i,i))-(j&gt;0 and tonumber(b:sub(j,j)) or 0)-borrow borrow=0 if n&lt;0 then n+=10 borrow=1 end table.insert(out,1,tostring(n)) j-=1 end return B.N(table.concat(out))
end
function B.MulSmall(a,n)
 assert(n&gt;=0 and n%1==0 and n&lt;=1e9) a=B.N(a) if n==0 then return "0" end local carry=0 local out={}
 for i=#a,1,-1 do local v=tonumber(a:sub(i,i))*n+carry table.insert(out,1,tostring(v%10)) carry=math.floor(v/10) end
 while carry&gt;0 do table.insert(out,1,tostring(carry%10)) carry=math.floor(carry/10) end return B.N(table.concat(out))
end
function B.Mul(a,b)
 a=B.N(a) b=B.N(b) local result="0"
 for i=1,#b do result=B.Add(result.."0",B.MulSmall(a,tonumber(b:sub(i,i)))) end return B.N(result)
end
function B.Div(a,b)
 a=B.N(a) b=B.N(b) assert(b~="0","Division by zero") local rem="0" local out={}
 for i=1,#a do
  rem=B.N(rem..a:sub(i,i)) local lo,hi=0,9
  while lo&lt;hi do local mid=math.ceil((lo+hi)/2) if B.Cmp(B.MulSmall(b,mid),rem)&lt;=0 then lo=mid else hi=mid-1 end end
  table.insert(out,tostring(lo)) rem=B.Sub(rem,B.MulSmall(b,lo))
 end return B.N(table.concat(out)),rem
end
function B.Min(a,b) return B.Cmp(a,b)&lt;=0 and a or b end
function B.Format(n)
 n=B.N(n) local suffix={"","K","M","B","T","Qa","Qi","Sx","Sp","Oc","No","Dc"} local tier=math.floor((#n-1)/3)
 if tier==0 then return n end if tier&gt;=#suffix then return n:sub(1,1).."."..n:sub(2,3).."e"..(#n-1) end
 local len=#n-tier*3 local decimal=n:sub(len+1,len+1) return n:sub(1,len)..(decimal~="0" and "."..decimal or "")..suffix[tier+1]
end
function B.Score(n) n=B.N(n) if n=="0" then return 0 end return #n*1000000+math.floor(tonumber(n:sub(1,6)..string.rep("0",math.max(0,6-#n)))) end
return B
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Assets</string>
          <ProtectedString name="Source">-- Shared editable toy geometry, built from Roblox primitives; no external mesh or texture dependencies.
local A={}
function A.Part(parent,name,size,cf,color,shape)
 local p=Instance.new("Part") p.Name=name p.Size=size p.CFrame=typeof(cf)=="CFrame" and cf or CFrame.new(cf) p.Anchored=true p.CanCollide=false p.CanTouch=false p.Material=Enum.Material.SmoothPlastic p.Color=color p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth
 if shape==Enum.PartType.Ball then local mesh=Instance.new("SpecialMesh") mesh.MeshType=Enum.MeshType.Sphere mesh.Parent=p elseif shape then p.Shape=shape end p.Parent=parent return p
end
function A.Wedge(parent,name,size,cf,color)
 local p=Instance.new("WedgePart") p.Name=name p.Size=size p.CFrame=cf p.Color=color p.Anchored=true p.CanCollide=false p.CanTouch=false p.Material=Enum.Material.SmoothPlastic p.Parent=parent return p
end
function A.Cylinder(parent,name,radius,height,cf,color)
 return A.Part(parent,name,Vector3.new(height,radius*2,radius*2),cf*CFrame.Angles(0,0,math.pi/2),color,Enum.PartType.Cylinder)
end
function A.Label(part,text,width,height,offset,max)
 local g=Instance.new("BillboardGui") g.Name="Label" g.Size=UDim2.fromOffset(width or 180,height or 40) g.StudsOffset=Vector3.new(0,offset or 4,0) g.MaxDistance=max or 70 g.AlwaysOnTop=false g.Parent=part
 local l=Instance.new("TextLabel") l.BackgroundTransparency=1 l.Size=UDim2.fromScale(1,1) l.Text=text l.TextColor3=Color3.fromRGB(255,249,222) l.TextStrokeColor3=Color3.fromRGB(36,59,52) l.TextStrokeTransparency=.25 l.Font=Enum.Font.GothamBold l.TextSize=16 l.TextWrapped=true l.Parent=g return l
end
function A.Face(part,text,color,face)
 local g=Instance.new("SurfaceGui") g.Name="SignFace" g.Face=face or Enum.NormalId.Front g.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud g.PixelsPerStud=35 g.Parent=part
 local t=Instance.new("TextLabel") t.Size=UDim2.new(1,-12,1,-8) t.Position=UDim2.fromOffset(6,4) t.BackgroundTransparency=1 t.Font=Enum.Font.GothamBold t.TextScaled=true t.TextColor3=color or Color3.fromRGB(255,248,214) t.Text=text t.TextWrapped=true t.Parent=g return t
end
function A.Prompt(part,text,object,hold,distance)
 local p=Instance.new("ProximityPrompt") p.ActionText=text p.ObjectText=object p.HoldDuration=hold or 0 p.MaxActivationDistance=distance or 12 p.RequiresLineOfSight=false p.Parent=part return p
end
function A.Particles(parent,color,rate)
 local e=Instance.new("ParticleEmitter") e.Color=ColorSequence.new(color) e.LightEmission=.5 e.Rate=rate or 2 e.Lifetime=NumberRange.new(.6,1.4) e.Speed=NumberRange.new(.3,1) e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.12),NumberSequenceKeypoint.new(1,0)}) e.SpreadAngle=Vector2.new(180,180) e.Parent=parent return e
end
function A.Pet(species,pet,C)
 pet=pet or {Variant="Normal",Mutations={},Size="Normal",Level=1}
 local m=Instance.new("Model") m.Name=species.Name local color=species.Color local r=species.Rarity local gold=Color3.fromRGB(255,205,60) local pale=Color3.fromRGB(255,242,211)
 if pet.Variant=="Silver" then color=Color3.fromRGB(195,207,218) elseif pet.Variant=="Gold" then color=gold elseif pet.Variant=="Diamond" then color=Color3.fromRGB(123,222,255) elseif pet.Variant=="Rainbow" then color=Color3.fromRGB(240,128,232) end
 local function p(n,s,pos,c,shape) return A.Part(m,n,s,CFrame.new(pos),c,shape) end
 local body=p("Body",Vector3.new(2.7,2.7,2.7),Vector3.zero,color) m.PrimaryPart=body
 if pet.Variant=="Silver" or pet.Variant=="Gold" then body.Material=Enum.Material.Metal elseif pet.Variant=="Diamond" then body.Material=Enum.Material.Glass body.Reflectance=.15 end
 local name=species.Name:lower()
 local bird=name:find("owl") or name:find("jay") or name:find("raven") or name:find("chick") or name:find("phoenix")
 for side=-1,1,2 do
  p("EyeWhite",Vector3.new(.78,.94,.26),Vector3.new(side*.65,.25,-1.34),Color3.new(1,1,1),Enum.PartType.Ball)
  p("Pupil",Vector3.new(.4,.62,.18),Vector3.new(side*.65,.23,-1.5),Color3.fromRGB(29,40,48),Enum.PartType.Ball)
  p("EyeShine",Vector3.new(.13,.19,.08),Vector3.new(side*.65-.07,.39,-1.61),Color3.new(1,1,1),Enum.PartType.Ball)
  p("TinyFoot",Vector3.new(.64,.36,.78),Vector3.new(side*.78,-1.47,-.55),bird and gold or color:Lerp(pale,.25))
  if bird then
   local wing=p("Wing",Vector3.new(.45,1.2,1.25),Vector3.new(side*1.43,-.1,.1),color:Lerp(pale,.2)) wing.Orientation=Vector3.new(0,0,side*12)
  else
   local tall=name:find("bunny") and 1.65 or .85
   local ear=p("Ear",Vector3.new(.68,tall,.6),Vector3.new(side*.88,1.38+tall*.3,0),color)
   p("InnerEar",Vector3.new(.35,tall*.65,.08),ear.Position+Vector3.new(0,0,-.32),Color3.fromRGB(241,162,167))
  end
 end
 if bird then
  A.Wedge(m,"Beak",Vector3.new(.5,.5,.6),CFrame.new(0,-.35,-1.62)*CFrame.Angles(math.pi/2,0,0),gold)
 else
  p("Muzzle",Vector3.new(1.2,.65,.17),Vector3.new(0,-.55,-1.37),pale,Enum.PartType.Ball)
  p("Nose",Vector3.new(.35,.22,.18),Vector3.new(0,-.34,-1.56),Color3.fromRGB(90,55,55),Enum.PartType.Ball)
  local smile=p("Smile",Vector3.new(.37,.06,.08),Vector3.new(0,-.7,-1.48),Color3.fromRGB(76,57,57))
 end
 if name:find("fox") or name:find("cat") or name:find("wolf") or name:find("lynx") or name:find("pup") or name:find("hound") then
  local tail=p("Tail",Vector3.new(.65,.65,1.6),Vector3.new(.8,-.7,1.9),color) tail.Orientation=Vector3.new(-20,25,0)
  p("TailTip",Vector3.new(.67,.67,.55),Vector3.new(1.1,-.4,2.55),pale)
 end
 if name:find("deer") or name:find("stag") or name:find("dragon") or name:find("drake") or name:find("imp") then
  for side=-1,1,2 do local horn=p("Horn",Vector3.new(.28,1.1,.28),Vector3.new(side*.9,1.9,.4),gold) horn.Orientation=Vector3.new(-12,0,side*-20)
   if name:find("deer") or name:find("stag") then p("Antler",Vector3.new(.6,.2,.2),Vector3.new(side*1.04,2,.4),gold) end
  end
 end
 if name:find("moth") or name:find("dragon") or name:find("pegasus") or name:find("seraph") or name:find("griffin") or name:find("phoenix") then
  for side=-1,1,2 do
   for i=1,3 do local wing=p("WingFeather",Vector3.new(.9,.36,1.4),Vector3.new(side*(1.4+i*.22),.5-i*.2,.3+i*.15),r&gt;=8 and pale or color:Lerp(pale,.3)) wing.Orientation=Vector3.new(0,side*25,side*30) end
  end
 end
 if name:find("hedgehog") or name:find("badger") then for i=1,5 do A.Wedge(m,"Spine",Vector3.new(.5,.65,.7),CFrame.new(-1.1+i*.38,1.55,.6),color:Lerp(Color3.fromRGB(63,73,76),.4)) end end
 if r==4 then
  A.Cylinder(m,"HatBrim",1.1,.13,CFrame.new(0,1.65,0),Color3.fromRGB(80,45,116))
  local hat=p("WizardHat",Vector3.new(1,1.1,1),Vector3.new(0,2.17,0),Color3.fromRGB(91,50,143)) hat.Orientation=Vector3.new(0,0,-12)
  p("HatStar",Vector3.new(.22,.3,.1),Vector3.new(0,2.17,-.56),gold)
 elseif r&gt;=5 then
  for i=1,5 do local a=i*math.pi*2/5 local q=p("Crown",Vector3.new(.26,.55,.26),Vector3.new(math.sin(a)*.77,1.64,math.cos(a)*.77),gold) q.Material=Enum.Material.Metal end
 end
 if r&gt;=8 then
  for i=1,12 do local a=i*math.pi/6 local h=p("Halo",Vector3.new(.5,.13,.24),Vector3.new(math.sin(a)*1.05,2.3,math.cos(a)*1.05),gold) h.Orientation=Vector3.new(0,-math.deg(a),0) h.Material=Enum.Material.Neon end
 end
 for _,id in ipairs(pet.Mutations or {}) do
  for _,w in ipairs(C.Weather) do if id==w.Mutation then
   A.Particles(body,w.Color,2)
   if id=="Soaked" then for i=1,3 do p("Droplet",Vector3.new(.16,.35,.13),Vector3.new(-1+i*.5,.65-i*.25,-1.45),w.Color,Enum.PartType.Ball) end
   elseif id=="Frozen" then for side=-1,1,2 do local ice=A.Wedge(m,"FrostCrystal",Vector3.new(.45,.85,.45),CFrame.new(side*1.25,1.5,.5),w.Color) ice.Material=Enum.Material.Glass end
   elseif id=="Thunderstruck" then for i=1,3 do local spark=p("ElectricArc",Vector3.new(.12,.55,.12),Vector3.new(1.5,.9-i*.45,-.8),w.Color) spark.Orientation=Vector3.new(0,0,i%2==0 and 35 or -35) spark.Material=Enum.Material.Neon end
   elseif id=="Enraged" then for side=-1,1,2 do local flame=A.Wedge(m,"Flame",Vector3.new(.45,.8,.4),CFrame.new(side*1.4,-.6,.4),w.Color) flame.Material=Enum.Material.Neon end
   elseif id=="Celestial" then for i=1,3 do local star=p("StarFragment",Vector3.new(.24,.24,.24),Vector3.new(-1+i*.5,1.6,.4),w.Color) star.Orientation=Vector3.new(30,0,45) star.Material=Enum.Material.Neon end
   elseif id=="Astral" then for i=1,6 do local a=i*math.pi/3 local ribbon=p("AuroraRibbon",Vector3.new(.65,.12,.18),Vector3.new(math.sin(a)*1.65,.5+math.cos(a)*.3,math.cos(a)*1.65),w.Color) ribbon.Orientation=Vector3.new(0,-math.deg(a),10) ribbon.Material=Enum.Material.Neon end end
  end end
 end
 if pet.Variant=="Rainbow" or r==10 then body:SetAttribute("Rainbow",true) A.Particles(body,Color3.fromRGB(255,139,231),3) end
 if pet.Level&gt;=50 then p("Scarf",Vector3.new(2.76,.3,2.76),Vector3.new(0,-.9,0),gold) end
 if pet.Size=="Huge" then m:ScaleTo(2.2) end
 return m
end
function A.Bat(r,C,tool)
 local m=tool and Instance.new("Tool") or Instance.new("Model") m.Name=tool and "Forest Bat" or C.Rarities[r].." Bat"
 if tool then m.CanBeDropped=false end
 local brown=Color3.fromRGB(124,78,41) local col=C.Colors[r] local base=Vector3.zero
 local handle=A.Part(m,"Handle",Vector3.new(.42,3.8,.42),CFrame.new(),r&gt;=8 and Color3.fromRGB(242,232,201) or brown,Enum.PartType.Cylinder)
 handle.Orientation=Vector3.new(0,0,90) handle.Anchored=not tool handle.Massless=true
 local barrel=A.Part(m,"Barrel",Vector3.new(.8,2.2,.8),CFrame.new(0,1.4,0),r==1 and brown or col,Enum.PartType.Cylinder) barrel.Orientation=Vector3.new(0,0,90)
 for i=1,3 do
  local leaf=A.Part(m,"Leaf",Vector3.new(.38,.65,.14),CFrame.new((i%2==0 and 1 or -1)*.38,.3+i*.55,0)*CFrame.Angles(0,0,i%2==0 and -.6 or .6),r&lt;=2 and Color3.fromRGB(75,161,67) or col)
 end
 if r&gt;=3 then for i=1,3 do local q=A.Wedge(m,"Crystal",Vector3.new(.4,.7,.4),CFrame.new((i-2)*.35,2.6,0),col) q.Material=Enum.Material.Neon end end
 if r&gt;=4 then A.Particles(barrel,col,2) end
 if tool then
  for _,p in ipairs(m:GetDescendants()) do if p:IsA("BasePart") then p.Anchored=false p.Massless=true if p~=handle then local weld=Instance.new("WeldConstraint") weld.Part0=handle weld.Part1=p weld.Parent=p end end end
 else m.PrimaryPart=handle end return m
end
return A


</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">HUD</string>
          <ProtectedString name="Source">-- Code-drawn icon HUD based on the user's colorful simulator toolbar reference.
local H={}
local Tween=game:GetService("TweenService")
local dark=Color3.fromRGB(35,36,67)
local colors={Pets=Color3.fromRGB(109,225,94),Index=Color3.fromRGB(79,207,255),Food=Color3.fromRGB(255,186,98),Shop=Color3.fromRGB(236,114,247),Inbox=Color3.fromRGB(255,207,65),Bats=Color3.fromRGB(164,129,250),Guide=Color3.fromRGB(107,168,249),Settings=Color3.fromRGB(173,191,199)}
local function radius(o,n) local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,n) c.Parent=o end
local function outline(o,n,color) local s=Instance.new("UIStroke") s.Thickness=n or 2 s.Color=color or dark s.Transparency=0 s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border s.Parent=o end
local function shape(parent,x,y,w,h,c,round,rot)
 local f=Instance.new("Frame") f.Size=UDim2.fromScale(w,h) f.Position=UDim2.fromScale(x,y) f.BackgroundColor3=c f.BorderSizePixel=0 f.Rotation=rot or 0 f.Parent=parent if round then radius(f,round) end return f
end
local function text(parent,txt,size,pos,ts,color)
 local t=Instance.new("TextLabel") t.Size=size t.Position=pos t.BackgroundTransparency=1 t.Text=txt t.TextColor3=color or Color3.new(1,1,1) t.Font=Enum.Font.GothamBlack t.TextSize=ts or 15 t.TextStrokeColor3=dark t.TextStrokeTransparency=0 t.Parent=parent return t
end
local function gradient(o,col)
 local g=Instance.new("UIGradient") g.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,col:Lerp(Color3.new(1,1,1),.42)),ColorSequenceKeypoint.new(.5,col),ColorSequenceKeypoint.new(1,col:Lerp(Color3.new(0,0,0),.2))}) g.Rotation=90 g.Parent=o
end
-- Set after uploading assets/menu-icons.png to the owning Roblox account.
H.Atlas = ""
local cells={Pets=0,Shop=1,Index=2,Food=3,Bats=4,Guide=5,Settings=6,Boosts=7,Coins=8}
function H.Icon(parent,name)
 local icon=Instance.new("ImageLabel") icon.Name=name.."Image" icon.BackgroundTransparency=1
 icon.Size=UDim2.fromScale(.92,.92) icon.Position=UDim2.fromScale(.04,.04)
 icon.Image=H.Atlas icon.ScaleType=Enum.ScaleType.Fit
 local cell=cells[name] or 5 local step=1280/3
 icon.ImageRectOffset=Vector2.new(math.floor(cell%3*step),math.floor(math.floor(cell/3)*step))
 icon.ImageRectSize=Vector2.new(math.floor(step),math.floor(step)) icon.Parent=parent
 return icon
end
local function tile(parent,name,pos,size,callback,color)
 local shadow=Instance.new("Frame") shadow.Name=name.."Shadow" shadow.Size=UDim2.fromOffset(size,size) shadow.Position=pos+UDim2.fromOffset(0,4) shadow.BackgroundColor3=dark shadow.BackgroundTransparency=.25 shadow.BorderSizePixel=0 shadow.Parent=parent radius(shadow,10)
 local b=Instance.new("ImageButton") b.Name=name.."Button" b.Image="" b.Size=UDim2.fromOffset(size,size) b.Position=pos b.BackgroundColor3=color or colors[name] or colors.Guide b.BorderSizePixel=0 b.Parent=parent b.AutoButtonColor=false radius(b,9) outline(b,2.5) gradient(b,b.BackgroundColor3)
 local inner=shape(b,.075,.075,.85,.85,Color3.new(1,1,1),6) inner.BackgroundTransparency=.8 outline(inner,1,Color3.fromRGB(255,255,255))
 H.Icon(b,name)
 local tooltip=text(b,name,UDim2.new(1.8,0,0,18),UDim2.new(-.4,0,0,-24),13) tooltip.Visible=false tooltip.ZIndex=6
 b.MouseEnter:Connect(function() tooltip.Visible=true Tween:Create(b,TweenInfo.new(.1),{Rotation=-4}):Play() end)
 b.MouseLeave:Connect(function() tooltip.Visible=false Tween:Create(b,TweenInfo.new(.1),{Rotation=0}):Play() end)
 b.Activated:Connect(function() callback(name) end) return b
end
function H.New(gui,callbacks)
 local out={}
 local bar=Instance.new("Frame") bar.Name="SimulatorToolbar" bar.Size=UDim2.fromOffset(426,73) bar.AnchorPoint=Vector2.new(.5,1) bar.Position=UDim2.new(.5,0,1,-7) bar.BackgroundTransparency=1 bar.Parent=gui
 local barScale=Instance.new("UIScale") barScale.Parent=bar
 for i,name in ipairs({"Pets","Shop","Index","Food","Bats","Guide"}) do local b=tile(bar,name,UDim2.fromOffset(12+(i-1)*69,5),54,function(n) callbacks.Open(n) end) text(b,name,UDim2.new(1.4,0,0,15),UDim2.new(-.2,0,1,5),10) end
 local top=Instance.new("Frame") top.Name="CurrencyPills" top.Size=UDim2.fromOffset(154,74) top.AnchorPoint=Vector2.new(.5,0) top.Position=UDim2.new(.5,0,0,5) top.BackgroundTransparency=1 top.Parent=gui
 local topScale=Instance.new("UIScale") topScale.Parent=top
 local function pill(name,index,color)
  local f=shape(top,0,0,1,1,color,11) f.Size=UDim2.fromOffset(154,31) f.Position=UDim2.fromOffset((index-1)*169,0) outline(f,2) gradient(f,color)
  local holder=shape(f,0,0,.23,1,color) holder.BackgroundTransparency=1 H.Icon(holder,name)
  local value=text(f,"0",UDim2.new(.7,0,1,0),UDim2.new(.27,0,0,0),18) value.TextXAlignment=Enum.TextXAlignment.Right
  local title=text(f,name=="Rate" and "Coins / sec" or name,UDim2.new(1,0,0,14),UDim2.new(0,0,1,1),10)
  return value
 end
 out.Coins=pill("Coins",1,Color3.fromRGB(255,199,45))
 out.Rate=text(gui,"0 Coins / sec",UDim2.fromOffset(170,24),UDim2.new(0,12,1,-115),15)
 out.Rate.Name="FarmingRate" out.Rate.TextXAlignment=Enum.TextXAlignment.Left
 local switch=Instance.new("TextButton") switch.Name="ForestSwitch" switch.Size=UDim2.fromOffset(100,23) switch.Position=UDim2.fromOffset(27,49) switch.Text="FOREST" switch.TextSize=12 switch.Font=Enum.Font.GothamBold switch.TextColor3=Color3.new(1,1,1) switch.BackgroundColor3=Color3.fromRGB(67,197,194) switch.Parent=top radius(switch,6) outline(switch,1.5) gradient(switch,switch.BackgroundColor3) switch.Activated:Connect(function() callbacks.Open("Index") end)
 local side=Instance.new("Frame") side.Name="UtilityButtons" side.Size=UDim2.fromOffset(52,236) side.AnchorPoint=Vector2.new(1,.5) side.Position=UDim2.new(1,-12,.5,0) side.BackgroundTransparency=1 side.Parent=gui
 for i,name in ipairs({"Shop","Pets","Index","Settings"}) do tile(side,name,UDim2.fromOffset(3,(i-1)*59),44,function(n) callbacks.Open(n) end,i==1 and Color3.fromRGB(255,109,122) or colors[name]) end
 local status=text(gui,"MY LITTLE PETS • FOREST",UDim2.new(.8,0,0,19),UDim2.new(.1,0,0,82),11) out.Status=status
 out.Help=text(gui,"Stand near treasure to farm",UDim2.new(.8,0,0,21),UDim2.new(.1,0,1,-105),12)
 local rush=Instance.new("TextButton") rush.Size=UDim2.fromOffset(122,31) rush.Position=UDim2.new(0,12,.5,-15) rush.Text="JOIN EGG RUSH" rush.TextColor3=Color3.new(1,1,1) rush.Font=Enum.Font.GothamBlack rush.TextSize=12 rush.BackgroundColor3=Color3.fromRGB(100,215,71) rush.Parent=gui radius(rush,8) outline(rush,2) gradient(rush,rush.BackgroundColor3) rush.Visible=false rush.Activated:Connect(callbacks.Rush) out.Rush=rush
 local boost=tile(gui,"Boosts",UDim2.new(0,12,1,-85),54,function() callbacks.Open("Shop") end,Color3.fromRGB(79,220,58))
 text(boost,"Boosts",UDim2.new(1.5,0,0,17),UDim2.new(-.25,0,1,3),11)
 local function resize()
  local cam=workspace.CurrentCamera if not cam then return end local w=cam.ViewportSize.X
  barScale.Scale=math.min(1,(w-26)/426) topScale.Scale=1
  local small=w&lt;650
  bar.Position=UDim2.new(.5,0,1,-7)
  boost.Position=UDim2.new(0,12,1,small and -170 or -85)
  out.Rate.Position=boost.Position+UDim2.fromOffset(0,-30)
  side.Position=UDim2.new(1,-8,.5,0)
 end
 resize() local cam=workspace.CurrentCamera if cam then local w=cam.ViewportSize.X barScale.Scale=math.min(1,(w-26)/510) topScale.Scale=math.min(1,(w-30)/500) boost.Visible=w&gt;700 side.Position=UDim2.new(1,-8,.5,0) end end
 resize() if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end return out
end
return H

